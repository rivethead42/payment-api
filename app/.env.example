# Copy to .env for local runs (never commit real secrets)
NODE_ENV=production
SERVICE_NAME=payment-api
POD_NAME=REPLACE_WITH_YOUR_POD_NAME
PAYMENT_PROCESSOR_MODE=healthy
PAYMENT_PROCESSOR_POOL_SIZE=50
PAYMENT_PROCESSOR_TIMEOUT=10000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
LOG_LEVEL=info
PORT=3000
